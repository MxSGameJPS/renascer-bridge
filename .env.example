# URL pública do sistema Renascer. Fora do localhost, use HTTPS.
RENASCER_API_URL=http://localhost:3000

# Opcional em desenvolvimento. Em produção, prefira configurar no próprio app.
# RENASCER_BRIDGE_TOKEN=rbg_...

# Atalho global da janela rápida. O padrão no Windows é Ctrl + Alt + R.
RENASCER_BRIDGE_SHORTCUT=Control+Alt+R
